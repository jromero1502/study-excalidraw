      "boundElements": [],
      "updated": 1775276889784,
      "link": null,
      "locked": false,
      "text": "si tenemos dos números cuyos límites son:\n\n\n2^{w}-1 + 2^{w}-1\n\nOperemos:\n\n2*(2^w) - 2\n\n2^{w+1} - 2",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "si tenemos dos números cuyos límites son:\n\n\n2^{w}-1 + 2^{w}-1\n\nOperemos:\n\n2*(2^w) - 2\n\n2^{w+1} - 2",
      "autoResize": true,
      "lineHeight": 1.25
    },
