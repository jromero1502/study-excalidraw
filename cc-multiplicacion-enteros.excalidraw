      "updated": 1777668315428,
      "link": null,
      "locked": false,
      "text": "-2^{w-1} +^{t}_{w} -2^{w-1}\n\n\n-2^{w-1} - 2^{w-1}\n\n\n-1*( 2^{w-1} + 2^{w-1} )\n\n-1*( 2*(2^{w-1}) )\n\n-1 * 2^w\n\n-2^w -> NEGATIVE OVERFLOW - aritmética modular\n\n-2^w + 2^w\n\n0",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-2^{w-1} +^{t}_{w} -2^{w-1}\n\n\n-2^{w-1} - 2^{w-1}\n\n\n-1*( 2^{w-1} + 2^{w-1} )\n\n-1*( 2*(2^{w-1}) )\n\n-1 * 2^w\n\n-2^w -> NEGATIVE OVERFLOW - aritmética modular\n\n-2^w + 2^w\n\n0",
      "autoResize": true,
      "lineHeight": 1.25
