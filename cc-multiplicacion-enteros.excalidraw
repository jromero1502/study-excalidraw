      "updated": 1777671205035,
      "link": null,
      "locked": false,
      "text": "Para esta convención, tenemos que\nel rango posible de valores está en el siguiente:\n\n\n0 <= x * y < (2^w - 1)^2",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Para esta convención, tenemos que\nel rango posible de valores está en el siguiente:\n\n\n0 <= x * y < (2^w - 1)^2",
      "autoResize": true,
      "lineHeight": 1.25
    },
